<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Avatar -->
        <ImageView
            android:id="@+id/img_avatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle_avatar"
            android:contentDescription="Member avatar"
            android:padding="16dp"
            android:src="@drawable/ic_person"
            app:tint="@color/on_primary" />

        <!-- Relationship Label (Me, Mom, Dad) -->
        <TextView
            android:id="@+id/text_relation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Me" />

        <!-- Name -->
        <TextView
            android:id="@+id/text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Winson" />

        <!-- Adherence Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_badge"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <!-- Taken count: green -->
            <TextView
                android:id="@+id/text_taken_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/bg_dot_taken"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="@color/success"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="3 Taken" />

            <!-- Pending count: orange -->
            <TextView
                android:id="@+id/text_pending_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawableStart="@drawable/bg_dot_pending"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="@color/warning"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="1 Pending" />

            <!-- Missed count: red -->
            <TextView
                android:id="@+id/text_missed_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawableStart="@drawable/bg_dot_missed"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="@color/error"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="0 Missed" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
