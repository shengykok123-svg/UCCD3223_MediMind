rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isCommunityMember(targetUserId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(targetUserId)/community_members/$(request.auth.uid));
    }

    function isCommunityMirrorWriter(memberId) {
      return isAuthenticated() && request.auth.uid == memberId;
    }

    function isMirrorMemberCreate() {
      return request.resource.data.keys().hasOnly(["name", "shareableId", "addedAt"]) &&
        request.resource.data.name is string &&
        request.resource.data.shareableId is string &&
        request.resource.data.addedAt != null;
    }

    // Users collection
    match /users/{userId} {
      // Users must be able to look up other registered users by shareableId
      // and community screens read connected members' name/photo documents.
      // Keep writes owner-only.
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Medications sub-collection
      match /medications/{medicationId} {
        allow read, write: if isOwner(userId);
      }

      // Schedules sub-collection
      match /schedules/{scheduleId} {
        allow read, write: if isOwner(userId);
      }

      // Adherence logs sub-collection
      match /adherence_logs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // Daily adherence summary
      // Owner: full access
      // Connected community members: read-only
      match /daily_adherence/{dateId} {
        allow read: if isOwner(userId) || isCommunityMember(userId);
        allow write: if isOwner(userId);
      }

      // Community members sub-collection
      // Owner manages local metadata like customTitle.
      // The mirrored member may only create/delete their own mirror card so
      // request acceptance can establish the bidirectional connection.
      match /community_members/{memberId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) ||
          (isCommunityMirrorWriter(memberId) && isMirrorMemberCreate());
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId) || isCommunityMirrorWriter(memberId);
      }
    }

    // Friend requests collection
    match /friend_requests/{requestId} {
      // Allow read if you are the sender or receiver
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );

      // Allow create if you are the sender
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.fromUid && (
          request.resource.data.status == "pending" ||
          request.resource.data.type == "member_removed"
        );

      // Allow update if you are the receiver (accept/ignore)
      // or the sender (cancel)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.fromUid
      );

      // Only receiver or sender can delete
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    // Shareable ID counter
    // Used during registration to generate unique shareable IDs
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }
  }
}
