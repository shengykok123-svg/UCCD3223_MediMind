rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isCommunityMember(targetUserId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(targetUserId)/community_members/$(request.auth.uid));
    }

    // Users collection
    match /users/{userId} {
      // User can read/write their own profile
      allow read, write: if isOwner(userId);

      // Medications sub-collection
      match /medications/{medicationId} {
        allow read, write: if isOwner(userId);
      }

      // Schedules sub-collection
      match /schedules/{scheduleId} {
        allow read, write: if isOwner(userId);
      }

      // Adherence logs sub-collection
      match /adherence_logs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // Daily adherence summary
      // Owner: full access
      // Connected community members: read-only
      match /daily_adherence/{dateId} {
        allow read: if isOwner(userId) || isCommunityMember(userId);
        allow write: if isOwner(userId);
      }

      // Community members sub-collection
      // Only the owner may manage their own community member metadata
      match /community_members/{memberId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Friend requests collection
    match /friend_requests/{requestId} {
      // Allow read if you are the sender or receiver
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );

      // Allow create if you are the sender
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.status == "pending";

      // Allow update if you are the receiver (accept/ignore)
      // or the sender (cancel)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.fromUid
      );

      // Only receiver or sender can delete
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    // Shareable ID counter
    // Used during registration to generate unique shareable IDs
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }
  }
}
