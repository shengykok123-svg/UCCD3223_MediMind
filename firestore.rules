rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - owner access only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Medications - owner only
      match /medications/{medicationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Schedules - owner only
      match /schedules/{scheduleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Adherence logs - owner only
      match /adherence_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Daily adherence - any authenticated user can read (Community needs this),
      // owner can write from client side.
      // Cloud Functions use Admin SDK which bypasses these rules.
      match /daily_adherence/{dateId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Community members - owner and the member themselves can read/write
      match /community_members/{memberId} {
        allow read, write: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == memberId);
      }
    }

    // Friend requests - participants can read; sender can create; both can update
    match /friend_requests/{requestId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.receiverId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.senderId;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.receiverId);
    }
  }
}
